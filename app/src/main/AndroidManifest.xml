<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        hev-socks5-tunnel AAR'i minSdk 29 bildiriyor. ByeDPI secenegi yalnizca
        Android 10+ cihazlarda gosterilir/calistirilir; eski cihazlarda
        OpenVPN ve WireGuard kullanilabilir.
    -->
    <uses-sdk tools:overrideLibrary="hev.socks5.tunnel" />

    <!-- Ag erisimi -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- On planda calisan VPN servisi -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:targetApi="34" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Uygulama ici guncelleme: indirilen APK'yi kurma izni -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        Android 9 ve oncesinde guncelleme APK'sini, kaldirma isleminden sonra da
        kalacak sekilde Indirilenler klasorune kaydetmek icin gerekir. Android 10+
        MediaStore kullandigi icin bu izne ihtiyac duymaz.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!--
        BIND_VPN_SERVICE sistem tarafindan atanan bir signature iznidir; uygulama
        bu izni elde edemez. Gercek zorunluluk servis tanimindaki
        android:permission="android.permission.BIND_VPN_SERVICE" ile saglanir.
        Bilgilendirme amaciyla burada da tanimlanmistir.
    -->
    <uses-permission
        android:name="android.permission.BIND_VPN_SERVICE"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".MdcVpnApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MdcVpn"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Uygulama ici tarayici: AdGuard filtre listesiyle reklam engelleme -->
        <activity
            android:name=".browser.BrowserActivity"
            android:exported="false"
            android:label="@string/browser_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity" />

        <!-- Bildirimdeki "Baglantiyi Kes" aksiyonu -->
        <receiver
            android:name=".vpn.VpnControlReceiver"
            android:exported="false" />

        <!-- DPI atlatma: ciadpi (ByeDPI) + hev-socks5-tunnel -->
        <service
            android:name=".vpn.ByeDpiVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="false" />
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
        </service>

        <!-- Indirilen guncelleme paketini kurucuya guvenli sekilde acar -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
