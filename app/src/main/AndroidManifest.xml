<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Ag erisimi -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- On planda calisan VPN servisi -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:targetApi="34" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        BIND_VPN_SERVICE sistem tarafindan atanan bir signature iznidir; uygulama
        bu izni elde edemez. Gercek zorunluluk servis tanimindaki
        android:permission="android.permission.BIND_VPN_SERVICE" ile saglanir.
        Bilgilendirme amaciyla burada da tanimlanmistir.
    -->
    <uses-permission
        android:name="android.permission.BIND_VPN_SERVICE"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".MdcVpnApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MdcVpn">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Bildirimdeki "Baglantiyi Kes" aksiyonu -->
        <receiver
            android:name=".vpn.VpnControlReceiver"
            android:exported="false" />
    </application>
</manifest>
