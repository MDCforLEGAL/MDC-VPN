# =====================================================================
#  MDC VPN - gömülü varsayılan OpenVPN profili
# =====================================================================
#  Bu dosya bir SABLONDUR. Uygulama ile gerçek bir tünel kurmak için:
#
#   1. Kendi OpenVPN sunucunuzun istemci profilini (.ovpn) alın.
#   2. Aynı içeriği bu dosyaya yazın (veya uygulamadaki "Dosya Seç"
#      düğmesiyle kendi .ovpn dosyanızı içe aktarın).
#   3. Sertifika/anahtar bloklarını (ca / cert / key) profil içine gömülü
#      olarak bırakın; uygulama ek dosya istemez.
#
#  Not: Sertifika tabanlı profiller önerilir. Kullanıcı adı/parola isteyen
#  profiller (auth-user-pass) bu sürümde desteklenmez.
# =====================================================================

client
dev tun
proto udp
remote vpn.ornek-sunucu.com 1194
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
auth SHA256
cipher AES-256-GCM
data-ciphers AES-256-GCM:AES-128-GCM
tls-version-min 1.2
verb 3

<ca>
# Sunucunuzun CA sertifikasını buraya yapıştırın:
# -----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----
</ca>

<cert>
# İstemci sertifikasını buraya yapıştırın:
# -----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----
</cert>

<key>
# İstemci özel anahtarını buraya yapıştırın:
# -----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----
</key>
